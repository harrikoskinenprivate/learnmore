DATABASE_URL=postgresql://oppimistehtavat:oppimistehtavat@localhost:5432/oppimistehtavat
DATABASE_POOL_MAX=5

# Ensimmäinen opettaja luodaan komennolla npm run db:seed.
# Komento ei vaihda salasanaa, jos opettaja on jo olemassa.
TEACHER_NAME=Opettaja
TEACHER_EMAIL=opettaja@example.com
TEACHER_PASSWORD=opettaja-local-12

# Paikallinen kehitys tallentaa kuvat ja ohjevideon kansioon data/media.
# Tuotannossa Cloud Run saa MEDIA_STORE=gcs ja GCS_BUCKET asetuksista.
MEDIA_STORE=local
